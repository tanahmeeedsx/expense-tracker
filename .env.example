# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# Generate strong passwords with:  openssl rand -hex 24   (hex only - avoids quoting problems)

# ---- MongoDB ----
MONGO_DB=expense_tracker
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=expense_app
MONGO_APP_PASSWORD=change-me-app

# ---- App ----
# Public URL users open in the browser, e.g. http://<EC2_ELASTIC_IP> (or https://your-domain)
CORS_ORIGIN=http://localhost
# Host port for the web app (80 on EC2, use 8080 for local testing)
HTTP_PORT=80
# Image tag used by compose and the Scout scan script
APP_TAG=latest

# ---- AWS S3 backup ----
S3_BACKUP_BUCKET=
AWS_REGION=ap-southeast-1
